  <version>0.1.0</version>
  <description>自然言語指示をLLMで行動計画に変換し、Gazebo上の差動二輪ロボットを動かすパッケージ</description>
  <maintainer email="user@example.com">pai_student</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
